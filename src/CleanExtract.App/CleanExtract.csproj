<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CleanExtract</AssemblyName>
    <RootNamespace>CleanExtract</RootNamespace>
    <Product>Clean Extract</Product>
    <Version>0.1.0</Version>
    <Authors>Clean Extract</Authors>
    <Description>Clean extract for ZIP, RAR, and 7z archives using bundled 7-Zip.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CleanExtract.Core\CleanExtract.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\third_party\7zip\7zz.exe" Link="resources\7zz.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\third_party\7zip\7z.dll" Link="resources\7z.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\third_party\7zip\License.txt" Link="resources\7-Zip-License.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
