<Window x:Class="CleanExtract.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CleanExtract"
        Title="需要密码"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <DockPanel>
            <local:AppTitleBar DockPanel.Dock="Top"
                               TitleText="需要密码"
                               ShowMinimize="False"
                               ShowMaximize="False" />
            <StackPanel Margin="22">
                <TextBlock x:Name="PromptText"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />
                <PasswordBox x:Name="PasswordBox"
                             Padding="10,8"
                             FontSize="14" />
                <TextBlock x:Name="HintText"
                           Foreground="{StaticResource DangerBrush}"
                           Margin="0,8,0,0"
                           Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="取消"
                            Style="{StaticResource GhostButton}"
                            Click="OnCancel"
                            MinWidth="88"
                            Margin="0,0,8,0"
                            IsCancel="True" />
                    <Button Content="继续"
                            Style="{StaticResource PrimaryButton}"
                            Click="OnOk"
                            MinWidth="88"
                            IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
