<Window x:Class="CleanExtract.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CleanExtract"
        Title="CleanExtract"
        Width="460"
        MinWidth="420"
        MinHeight="520"
        MaxHeight="760"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver"
        Background="{StaticResource BgBrush}">
    <Window.Resources>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <DataTemplate x:Key="TrashItem">
            <Border Background="{StaticResource ChipBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Confidence}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding StatusNote}"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,4,0,0"
                               Visibility="{Binding HasStatusNote, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="以后总是保留"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding DataContext.AlwaysKeepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SuspiciousItem">
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Confidence}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding StatusNote}"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,4,0,0"
                               Visibility="{Binding HasStatusNote, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="以后总是保留"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding DataContext.AlwaysKeepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Margin="0,0,8,0" />
                        <Button Content="以后总是过滤"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding DataContext.AlwaysFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <DockPanel>
            <local:AppTitleBar DockPanel.Dock="Top"
                               TitleText="CleanExtract"
                               ShowMinimize="True"
                               ShowMaximize="False" />
            <Grid Margin="28,16,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Clean Extract"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="干净解压，自动过滤广告和垃圾文件"
                           Style="{StaticResource Muted}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="设置"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding SettingsCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Padding="12,6"
                    MinHeight="32" />
        </Grid>

        <!-- Home / drop -->
        <Grid Grid.Row="1"
              MinHeight="220"
              Visibility="{Binding ShowHome, Converter={StaticResource BoolToVis}}">
            <Rectangle RadiusX="16" RadiusY="16"
                       Stroke="{StaticResource LineBrush}"
                       StrokeThickness="1.4"
                       StrokeDashArray="5 4"
                       Fill="#FAF9F6" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="将压缩包拖到这里"
                           FontSize="16"
                           FontWeight="Medium"
                           HorizontalAlignment="Center" />
                <TextBlock Text="ZIP · RAR · 7z"
                           Style="{StaticResource Muted}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,16" />
                <Button Content="选择文件"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BrowseCommand}"
                        HorizontalAlignment="Center"
                        MinWidth="120" />
            </StackPanel>
        </Grid>

        <!-- Preview -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsPreview, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding ArchiveName}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ArchiveMeta}"
                           Style="{StaticResource Muted}"
                           Margin="0,6,0,8" />
                <TextBlock Text="{Binding PreviewSummary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <TextBlock Text="{Binding PreviewNote}"
                           Foreground="{StaticResource AccentBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           Visibility="{Binding HasPreviewNote, Converter={StaticResource BoolToVis}}" />

                <TextBlock Text="将跳过"
                           FontWeight="SemiBold"
                           FontSize="15" />
                <TextBlock Text="这些文件不会解压到磁盘。"
                           Style="{StaticResource Muted}"
                           Margin="0,4,0,8" />
                <ItemsControl ItemsSource="{Binding TrashRows}" ItemTemplate="{StaticResource TrashItem}" />
                <TextBlock Text="没有需要过滤的文件。"
                           Style="{StaticResource Muted}"
                           Margin="0,0,0,8"
                           Visibility="{Binding HasTrash, Converter={StaticResource InverseBoolToVis}}" />

                <TextBlock Text="将保留的可疑文件"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Margin="0,8,0,0" />
                <TextBlock Text="有广告嫌疑，但为避免误删而保留。"
                           Style="{StaticResource Muted}"
                           Margin="0,4,0,8" />
                <ItemsControl ItemsSource="{Binding SuspiciousRows}" ItemTemplate="{StaticResource SuspiciousItem}" />
                <TextBlock Text="没有可疑文件。"
                           Style="{StaticResource Muted}"
                           Visibility="{Binding HasSuspicious, Converter={StaticResource InverseBoolToVis}}" />

                <TextBlock Text="输出到"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Margin="0,16,0,0" />
                <TextBlock Text="{Binding OutputDirectory}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,4" />
                <TextBlock Text="{Binding OutputHint}"
                           Style="{StaticResource Muted}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <WrapPanel>
                    <Button Content="更改目录"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding BrowseOutputCommand}"
                            Margin="0,0,8,8"
                            Padding="12,7"
                            MinHeight="32" />
                    <Button Content="解压到当前目录"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ExtractHereCommand}"
                            Margin="0,0,8,8"
                            Padding="12,7"
                            MinHeight="32" />
                    <Button Content="独立文件夹"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding UseDefaultOutputCommand}"
                            Visibility="{Binding ShowRestoreOutput, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,0,8"
                            Padding="12,7"
                            MinHeight="32" />
                </WrapPanel>

                <Button Content="干净解压"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ExtractCommand}"
                        Margin="0,8,0,0" />
                <Button Content="换一个文件"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding ResetCommand}"
                        Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Running / analyzing -->
        <Border Grid.Row="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="22"
                MinHeight="220">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ArchiveName}"
                           FontWeight="SemiBold"
                           FontSize="16"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource Muted}"
                           Margin="0,12,0,20"
                           TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Height="6"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Muted}"
                               Text="{Binding ProgressPercentText}"
                               Visibility="{Binding ShowProgressPercent, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <Button Content="取消"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding CancelCommand}"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Left"
                        MinWidth="88" />
            </StackPanel>
        </Border>

        <!-- Success -->
        <Border Grid.Row="1"
                Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="22">
            <StackPanel>
                <TextBlock Text="{Binding ResultHeadline}"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding ResultDetail}"
                           Style="{StaticResource Muted}"
                           Margin="0,10,0,20"
                           TextWrapping="Wrap" />
                <Button Content="打开文件夹"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenFolderCommand}" />
                <Button Content="查看详情"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding ShowDetailsCommand}"
                        Margin="0,10,0,0" />
                <Button Content="再解压一个"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding ResetCommand}"
                        Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- Failed -->
        <Border Grid.Row="1"
                Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="22">
            <StackPanel>
                <TextBlock Text="{Binding ErrorHeadline}"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding ErrorText}"
                           Foreground="{StaticResource DangerBrush}"
                           Margin="0,10,0,20"
                           TextWrapping="Wrap" />
                <Button Content="返回"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ResetCommand}" />
            </StackPanel>
        </Border>

        <!-- Details -->
        <DockPanel Grid.Row="1" Visibility="{Binding IsDetails, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Bottom"
                    Content="返回结果"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding HideDetailsCommand}"
                    Margin="0,14,0,0" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                <StackPanel>
                    <TextBlock Text="已过滤"
                               FontWeight="SemiBold"
                               FontSize="16" />
                    <TextBlock Text="这些文件没有解压到磁盘。"
                               Style="{StaticResource Muted}"
                               Margin="0,4,0,10" />
                    <ItemsControl ItemsSource="{Binding TrashRows}" ItemTemplate="{StaticResource TrashItem}" />
                    <TextBlock Text="没有需要过滤的文件。"
                               Style="{StaticResource Muted}"
                               Visibility="{Binding HasTrash, Converter={StaticResource InverseBoolToVis}}" />

                    <TextBlock Text="已保留的可疑文件"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Margin="0,16,0,0" />
                    <TextBlock Text="有广告嫌疑，但为避免误删而保留。"
                               Style="{StaticResource Muted}"
                               Margin="0,4,0,10" />
                    <ItemsControl ItemsSource="{Binding SuspiciousRows}" ItemTemplate="{StaticResource SuspiciousItem}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
        </DockPanel>
    </Border>
</Window>
